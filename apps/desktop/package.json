{
  "name": "@modular/desktop-app",
  "version": "0.1.0",
  "private": true,
  "description": "Ordessa Desktop \u2014 \u672c\u5730\u4f18\u5148\u7684\u667a\u80fd\u4f53\u5de5\u4f5c\u53f0\u5bbf\u4e3b\uff08Electron\uff09",
  "productName": "Ordessa Desktop",
  "author": "Ordessa",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/mmm-05610/agent-box",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmm-05610/agent-box.git"
  },
  "type": "module",
  "main": "dist/electron-main.cjs",
  "scripts": {
    "dev": "npm run build && node electron/dev/run-dev.mjs",
    "build": "node packaging/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:electron": "node tests/smoke/smoke-electron.mjs",
    "start": "node electron/dev/run-dev.mjs",
    "build:icons": "node packaging/icons/build-icons.mjs",
    "build:info": "node packaging/build-info.mjs",
    "test:hygiene": "vitest run tests/host-main.test.ts -t 'PA-11 代码卫生' --maxWorkers=1"
  },
  "dependencies": {
    "@ordessa/extension-host": "0.1.0",
    "@ordessa/native-bridge": "0.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@ordessa/extension-api": "0.1.0",
    "@ordessa/ui-components": "0.1.0",
    "@ordessa/extension-loader": "0.1.0",
    "@ordessa/harness-contracts": "*"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "electron": "40.10.2",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vite": "8.2.0",
    "@lumino/coreutils": "2.2.3"
  }
}
