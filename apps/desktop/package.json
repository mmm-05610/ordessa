{
  "name": "@modular/desktop-app",
  "version": "0.1.0",
  "private": true,
  "description": "Ordessa Desktop — 本地优先的智能体工作台宿主（Electron）",
  "productName": "Ordessa Desktop",
  "author": "Ordessa",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/mmm-05610/agent-box",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmm-05610/agent-box.git"
  },
  "type": "module",
  "main": "dist/electron-main.cjs",
  "scripts": {
    "dev": "npm run build && node scripts/run-dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:electron": "node scripts/smoke-electron.mjs",
    "start": "node scripts/run-dev.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:info": "node scripts/build-info.mjs",
    "test:hygiene": "node scripts/test-release-hygiene.mjs"
  },
  "dependencies": {
    "@ordessa/extension-host": "0.1.0",
    "@ordessa/native-bridge": "0.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@ordessa/extension-api": "0.1.0",
    "@ordessa/ui-components": "0.1.0",
    "@ordessa/extension-loader": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "electron": "40.10.2",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vite": "8.2.0",
    "@lumino/coreutils": "2.2.3"
  }
}
