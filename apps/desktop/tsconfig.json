{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@extensions/ordessa.model-provider/contract.js": [
        "../../plugins/model-provider/desktop/src/contract.ts"
      ],
      "@extensions/ordessa.profile-api/contract.js": [
        "../../plugins/profile/api/src/index.ts"
      ],
      "@extensions/ordessa.contracts/contract.js": [
        "../../packages/frontend/contracts/foundation/src/contract.ts"
      ],
      "@extensions/ordessa.agent-contracts/contract.js": [
        "../../plugins/agent/contracts/src/contract.ts"
      ],
      "@extensions/example.contracts/contract.js": [
        "../../examples/service-contract/src/contract.ts"
      ],
      "@extensions/example.ui-contracts/contract.js": [
        "../../examples/ui-contracts/src/contract.ts"
      ],
      "@extensions/ordessa.chat-api/contract.js": [
        "../../plugins/chat/api/src/contract.ts"
      ],
      "@ordessa/ui-components/api": [
        "../../packages/frontend/ui-components/api/ui-components.ts"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "renderer",
    "electron",
    "../../packages/frontend/*/src",
    "../../packages/frontend/*/api",
    "../../packages/frontend/ui-components/react",
    "../../packages/frontend/ui-components/tests",
    "../../packages/frontend/ui/tests",
    "../../packages/frontend/contracts/*/src",
    "../../packages/frontend/workbench/api",
    "../../packages/frontend/workbench/src",
    "../../plugins/**/src",
    "../../plugins/*/tests",
    "../../plugins/*/*/tests",
    "../../products/desktop/ui-tests",
    "../../examples/*/src",
    "tests",
    "fixtures"
  ],
  "exclude": [
    "../../plugins/model-provider/desktop/tests",
    "../../plugins/model-provider/chat-contribution/tests",
    "../../plugins/skills/desktop/tests",
    "../../plugins/sandbox/frontend/tests"
  ]
}
