{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@extensions/ordessa.model-provider/contract.js": [
        "../../plugins/agents/resources/model-provider/desktop/src/contract.ts"
      ],
      "@extensions/ordessa.profile-api/contract.js": [
        "../../plugins/agents/profiles/ui/api/src/index.ts"
      ],
      "@extensions/ordessa.contracts/contract.js": [
        "../../packages/interfaces/channels/workbench/extension-api/contracts/foundation/src/contract.ts"
      ],
      "@extensions/ordessa.agent-contracts/contract.js": [
        "../../plugins/agents/ui/contracts/src/contract.ts"
      ],
      "@extensions/example.contracts/contract.js": [
        "../../examples/workbench/service-contract/src/contract.ts"
      ],
      "@extensions/example.ui-contracts/contract.js": [
        "../../examples/workbench/ui-contracts/src/contract.ts"
      ],
      "@extensions/ordessa.chat-api/contract.js": [
        "../../plugins/workbench/chat/api/src/contract.ts"
      ],
      "@ordessa/ui-components/api": [
        "../../packages/interfaces/channels/workbench/extension-runtime/ui-components/api/ui-components.ts"
      ],
      "@extensions/ordessa.harness-contracts/contract.js": [
        "../../packages/interfaces/channels/workbench/extension-api/contracts/harness/src/contract.ts"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "renderer",
    "electron",
    "../../packages/frontend/*/src",
    "../../packages/frontend/*/api",
    "../../packages/interfaces/channels/workbench/extension-runtime/ui-components/react",
    "../../packages/interfaces/channels/workbench/extension-runtime/ui-components/tests",
    "../../packages/interfaces/channels/workbench/ui/tests",
    "../../packages/interfaces/channels/workbench/extension-api/contracts/*/src",
    "../../packages/interfaces/channels/workbench/shell/workbench/api",
    "../../packages/interfaces/channels/workbench/shell/workbench/src",
    "../../plugins/**/src",
    "../../plugins/*/tests",
    "../../plugins/*/*/tests",
    "tests/product-ui",
    "../../examples/*/src",
    "tests",
    "fixtures"
  ],
  "exclude": [
    "../../plugins/agents/resources/model-provider/desktop/tests",
    "../../plugins/agents/resources/model-provider/chat-contribution/tests",
    "../../plugins/agents/resources/skills/desktop/tests",
    "../../plugins/agents/resources/sandbox/frontend/tests"
  ]
}
