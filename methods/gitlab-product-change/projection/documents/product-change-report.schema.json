    "outcome_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/phase_status"
        },
        "evaluation_window": {
          "$ref": "#/$defs/text"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "customer_and_operational_feedback_refs": {
          "$ref": "#/$defs/refs"
        },
        "decision": {
          "enum": [
            "continue",
            "iterate",
            "rollback",
            "abandon",
            "restart_validation",
            "extend_measurement",
            "unknown",
            "not_applicable"
          ]
        },
        "decision_rationale": {
          "$ref": "#/$defs/text"
        },
        "decision_owner": {
          "$ref": "#/$defs/text"
        },
        "decided_at": {
          "$ref": "#/$defs/text"
        },
        "follow_up_refs": {
          "$ref": "#/$defs/refs"
        }
