        "target": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "observed_value": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "measurement_window": {
          "$ref": "#/$defs/text"
        },
        "source_refs": {
          "$ref": "#/$defs/refs"
        },
        "owner": {
          "$ref": "#/$defs/text"
