      "required": [
        "url",
        "state",
        "source_revision",
        "merged_commit",
        "merged_at",
        "review_and_pipeline_refs",
        "merge_is_deployment_evidence"
      ]
    },
    "deployment_event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/text"
        },
        "target_environment": {
          "$ref": "#/$defs/text"
        },
        "version_or_commit": {
          "$ref": "#/$defs/text"
        },
        "result": {
          "enum": [
            "succeeded",
            "failed",
            "blocked",
            "unknown",
            "not_run"
          ]
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_evidence_refs": {
          "$ref": "#/$defs/refs"
        },
        "confirmed_by": {
          "$ref": "#/$defs/text"
        }
