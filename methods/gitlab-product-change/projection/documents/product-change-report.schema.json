        "merged_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "merged_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_and_pipeline_refs": {
          "$ref": "#/$defs/refs"
        },
        "merge_is_deployment_evidence": {
          "const": false
        }
