      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "skipped",
            "not_selected",
            "deferred"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "release_or_package_binding": {
          "$ref": "#/$defs/text"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployment_event"
          }
        },
        "post_deployment_migration_refs": {
          "$ref": "#/$defs/refs"
        },
        "live_version_confirmed": {
          "type": "boolean"
        },
        "confirmation_evidence_refs": {
          "$ref": "#/$defs/refs"
        },
        "upstream_release_state": {
          "enum": [
            "not_released",
            "published",
            "available",
            "unknown",
            "not_applicable"
          ]
        },
        "target_installation_state": {
          "enum": [
            "not_installed",
            "installed",
            "unknown",
            "not_applicable"
          ]
        },
        "target_installation_evidence_refs": {
          "$ref": "#/$defs/refs"
        }
      },
      "required": [
        "applicability",
        "rationale",
        "release_or_package_binding",
        "events",
        "post_deployment_migration_refs",
        "live_version_confirmed",
        "confirmation_evidence_refs",
        "upstream_release_state",
        "target_installation_state",
        "target_installation_evidence_refs"
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_model": {
          "enum": [
            "gitlab_com",
            "self_managed",
            "both",
            "other",
            "not_yet_selected"
          ]
        },
        "target_rationale": {
          "$ref": "#/$defs/text"
        },
        "gitlab_com_path": {
          "$ref": "#/$defs/deployment_path"
        },
        "self_managed_path": {
          "$ref": "#/$defs/deployment_path"
        },
        "deployment_dri": {
          "$ref": "#/$defs/text"
        },
        "verification_decision": {
          "$ref": "#/$defs/decision"
        }
      },
      "required": [
        "target_model",
        "target_rationale",
        "gitlab_com_path",
        "self_managed_path",
        "deployment_dri",
        "verification_decision"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
