        "reason": {
          "$ref": "#/$defs/text"
        },
        "closed_or_reviewed_by": {
          "$ref": "#/$defs/text"
        },
        "recorded_at": {
          "$ref": "#/$defs/text"
        },
        "feedback_and_follow_up_refs": {
          "$ref": "#/$defs/refs"
        },
