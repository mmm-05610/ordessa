        "new_revision_or_follow_up_ref": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "completed",
            "deferred",
            "cancelled"
          ]
        },
        "exit_criteria": {
          "$ref": "#/$defs/text"
        },
        "evidence_refs": {
          "$ref": "#/$defs/refs"
        }
