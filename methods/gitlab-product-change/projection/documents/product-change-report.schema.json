    "report_version": {
      "const": 1
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "validation_track": {
      "$ref": "#/$defs/validation_track"
    },
    "build_track": {
      "$ref": "#/$defs/build_track"
    },
    "track_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track_link"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "rework": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rework"
      }
    },
    "merge_requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/merge_request"
      }
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    },
    "outcome_evaluation": {
      "$ref": "#/$defs/outcome_evaluation"
    },
    "closure": {
      "$ref": "#/$defs/closure"
    },
    "source_snapshot": {
      "$ref": "#/$defs/source_snapshot"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision_observation"
      }
    }
  },
  "required": [
    "report_version",
    "identity",
    "roles",
    "validation_track",
    "build_track",
    "track_links",
    "blockers",
    "rework",
    "merge_requests",
    "deployment",
    "outcome_evaluation",
    "closure",
    "source_snapshot"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phase_status": {
      "enum": [
        "not_started",
        "active",
        "completed",
        "skipped",
        "blocked",
        "rework",
        "deferred",
        "rejected",
        "cancelled"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "$ref": "#/$defs/text"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "decided_by": {
          "$ref": "#/$defs/text"
        },
        "decided_at": {
          "$ref": "#/$defs/text"
        },
        "approval_or_record_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "result",
        "rationale",
        "decided_by",
        "decided_at",
        "approval_or_record_ref"
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/phase_status"
        },
        "entered_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "exited_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "outcome_or_skip_rationale": {
          "$ref": "#/$defs/text"
        },
        "evidence_refs": {
          "$ref": "#/$defs/refs"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        }
      },
      "required": [
        "status",
        "entered_at",
        "exited_at",
        "owner",
        "outcome_or_skip_rationale",
        "evidence_refs",
        "decision"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_path": {
          "$ref": "#/$defs/text"
        },
        "issue_url": {
          "$ref": "#/$defs/text"
        },
        "issue_title": {
          "$ref": "#/$defs/text"
        },
        "work_type": {
          "$ref": "#/$defs/text"
        },
        "product_area": {
          "$ref": "#/$defs/text"
        },
        "primary_dri": {
          "$ref": "#/$defs/text"
        },
        "issue_state_model": {
          "enum": [
            "issue_status",
            "workflow_label",
            "other"
          ]
        },
        "issue_state_value": {
          "$ref": "#/$defs/text"
        },
        "state_observed_at": {
          "$ref": "#/$defs/text"
        },
        "tracking_item_refs": {
          "$ref": "#/$defs/refs"
        }
      },
      "required": [
        "project_path",
        "issue_url",
        "issue_title",
        "work_type",
        "product_area",
        "primary_dri",
        "issue_state_model",
        "issue_state_value",
        "state_observed_at",
        "tracking_item_refs"
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase_or_decision": {
          "$ref": "#/$defs/text"
        },
        "role_name": {
          "$ref": "#/$defs/text"
        },
        "person_or_group": {
          "$ref": "#/$defs/text"
        },
        "authority_basis": {
          "$ref": "#/$defs/text"
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "phase_or_decision",
        "role_name",
        "person_or_group",
        "authority_basis",
        "approval_ref"
      ]
    },
    "validation_track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "skipped",
            "deferred"
          ]
        },
        "applicability_rationale": {
          "$ref": "#/$defs/text"
        },
        "problem_validation": {
          "$ref": "#/$defs/phase"
        },
        "design": {
          "$ref": "#/$defs/phase"
        },
        "solution_validation": {
          "$ref": "#/$defs/phase"
        },
        "success_hypotheses_and_metrics": {
          "$ref": "#/$defs/refs"
        },
        "validation_evidence_refs": {
          "$ref": "#/$defs/refs"
        }
      },
      "required": [
        "applicability",
        "applicability_rationale",
        "problem_validation",
        "design",
        "solution_validation",
        "success_hypotheses_and_metrics",
        "validation_evidence_refs"
      ]
    },
    "build_track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "partially_applicable",
            "skipped",
            "deferred"
          ]
        },
        "applicability_rationale": {
          "$ref": "#/$defs/text"
        },
        "plan": {
          "$ref": "#/$defs/phase"
        },
        "development": {
          "$ref": "#/$defs/phase"
        },
        "testing": {
          "$ref": "#/$defs/phase"
        },
        "review": {
          "$ref": "#/$defs/phase"
        },
        "verification": {
          "$ref": "#/$defs/phase"
        },
        "planning_refs": {
          "$ref": "#/$defs/refs"
        },
        "test_and_review_refs": {
          "$ref": "#/$defs/refs"
        }
      },
      "required": [
        "applicability",
        "applicability_rationale",
        "plan",
        "development",
        "testing",
        "review",
        "verification",
        "planning_refs",
        "test_and_review_refs"
      ]
    },
    "track_link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "overlap",
            "feeds",
            "blocks",
            "unblocks",
            "handoff",
            "skip_decision"
          ]
        },
        "validation_work_ref": {
          "$ref": "#/$defs/text"
        },
        "build_work_ref": {
          "$ref": "#/$defs/text"
        },
        "recorded_at": {
          "$ref": "#/$defs/text"
        },
        "recorded_by": {
          "$ref": "#/$defs/text"
        },
        "rationale_or_decision_ref": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "relation",
        "validation_work_ref",
        "build_work_ref",
        "recorded_at",
        "recorded_by",
        "rationale_or_decision_ref"
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "open",
            "resolved",
            "accepted_risk",
            "cancelled"
          ]
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "owner": {
          "$ref": "#/$defs/text"
        },
        "opened_at": {
          "$ref": "#/$defs/text"
        },
        "expected_resolution_at": {
          "type": [
            "string",
