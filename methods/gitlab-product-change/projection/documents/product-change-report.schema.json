      "required": [
        "status",
        "evaluation_window",
        "metrics",
        "customer_and_operational_feedback_refs",
        "decision",
        "decision_rationale",
        "decision_owner",
        "decided_at",
        "follow_up_refs"
      ]
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "complete_after_verification",
            "deferred",
            "cancelled",
            "duplicate",
            "wont_do",
            "open_follow_up",
            "not_closed",
            "deferred",
            "rejected"
          ]
