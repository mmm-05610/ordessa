    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_index_path": {
          "const": "SOURCES.md"
        },
        "retrieved_at": {
          "$ref": "#/$defs/text"
        },
        "source_policy_version_or_url": {
          "$ref": "#/$defs/text"
        },
        "version_discrepancies_not_resolved": {
          "$ref": "#/$defs/refs"
