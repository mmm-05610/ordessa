{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "maintenance-note"
    },
    "change": {
      "type": "string",
      "minLength": 1
    },
    "preserve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "document_type",
    "change",
    "preserve"
  ]
}
