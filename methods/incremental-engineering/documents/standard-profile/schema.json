{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordessa:method:incremental-engineering:standard-profile:2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "standard-profile"
    },
    "schema_version": {
      "const": 2
    },
    "status": {
      "enum": [
        "candidate",
        "accepted"
      ]
    },
    "acceptance_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "standard_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "object_id",
              "revision",
              "digest",
              "locator"
            ]
          },
          "applicable_clauses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tailoring": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "clause_id": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "applicable",
                    "not_applicable",
                    "modified"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "acceptance_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "object_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "object_id",
                    "revision",
                    "digest",
                    "locator"
                  ]
                }
              },
              "required": [
                "clause_id",
                "disposition",
                "reason",
                "acceptance_ref"
              ]
            }
          }
        },
        "required": [
          "standard_id",
          "revision",
          "source_ref",
          "applicable_clauses",
          "tailoring"
        ]
      }
    },
    "review_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "status",
    "standards",
    "review_scope"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "required": [
          "acceptance_ref"
        ]
      }
    }
  ]
}
