{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordessa:method:incremental-engineering:correction-plan:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": { "const": "correction-plan" },
    "schema_version": { "const": 1 },
    "approved_did_ref": { "$ref": "#/$defs/artifact_revision_ref" },
    "approved_package_ref": { "$ref": "#/$defs/artifact_revision_ref" },
    "failed_submission_ref": { "$ref": "#/$defs/submission_ref" },
    "failed_review_ref": { "$ref": "#/$defs/review_ref" },
    "proposed_corrections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "failed_check_key": { "$ref": "#/$defs/check_key" },
          "target_ref": { "$ref": "#/$defs/artifact_revision_ref" },
          "change": { "type": "string", "minLength": 1 },
          "validation_steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": { "type": "string", "minLength": 1 }
          },
          "scope_basis_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/artifact_revision_ref" },
                { "$ref": "#/$defs/submission_ref" },
                { "$ref": "#/$defs/review_ref" }
              ]
            }
          }
        },
        "required": [
          "criterion_id", "target_ref", "change", "validation_steps", "scope_basis_refs"
        ]
      }
    }
  },
  "required": [
    "document_type", "schema_version", "approved_did_ref", "approved_package_ref",
    "failed_submission_ref", "failed_review_ref", "proposed_corrections"
  ],
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["algorithm", "hex"]
    },
    "artifact_revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "artifact_revision" },
        "realm_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "revision_id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["kind", "realm_id", "project_id", "artifact_id", "revision_id", "digest"]
    },
    "submission_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "submission" },
        "realm_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "submission_id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["kind", "realm_id", "project_id", "submission_id", "digest"]
    },
    "review_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "review" },
        "realm_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "review_id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["kind", "realm_id", "project_id", "review_id", "digest"]
    },
    "proposal_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "proposal" },
        "realm_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "change_id": { "type": "string", "minLength": 1 },
        "proposal_id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["kind", "realm_id", "project_id", "change_id", "proposal_id", "digest"]
    },
    "repository_snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "repository_snapshot" },
        "realm_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "repository_id": { "type": "string", "minLength": 1 },
        "vcs": { "enum": ["git", "none"] },
        "commit_id": { "type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "tree_digest": { "$ref": "#/$defs/digest" },
        "dirty_overlay_digest": {
          "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        }
      },
      "required": ["kind", "realm_id", "project_id", "repository_id", "vcs", "commit_id", "tree_digest", "dirty_overlay_digest"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["primary", "base", "proposed", "output", "support"] },
        "ref": {
          "oneOf": [
            { "$ref": "#/$defs/artifact_revision_ref" },
            { "$ref": "#/$defs/submission_ref" },
            { "$ref": "#/$defs/proposal_ref" },
            { "$ref": "#/$defs/repository_snapshot_ref" }
          ]
        }
      },
      "required": ["role", "ref"]
    },
    "check_key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "criterion_id": { "type": "string", "minLength": 1 },
        "claim_id": { "type": ["string", "null"], "minLength": 1 }
      },
      "required": ["target", "criterion_id", "claim_id"]
    }
  }
}
