{
  "schemaVersion": "ordessa.agent-report-review-contract/1",
  "capabilityId": "engineering.reviewer.agent",
  "interfaceVersion": "1",
  "authorshipContract": "engineering-agent-report-authorship/1",
  "locatorContract": "ordessa.declared-agent-report-review-source/1",
  "submissionContract": "engineering-agent-submission-report/1",
  "executionContract": "engineering-agent-execution-ref/2",
  "targetKind": "persisted-submission",
  "criterionResourceId": "implementation-review-criteria",
  "promptResourceId": "independent-review-prompt",
  "profileSelectionResourceId": "profile-selection-prompt",
  "identityConstraint": "original_author_agent_identity_must_differ_from_original_reviewer_agent_identity",
  "requiredTerminalState": "completed",
  "requiredStopReason": "end_turn",
  "readOnly": true,
  "responseSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "verdict",
      "rationale",
      "findings"
    ],
    "properties": {
      "verdict": {
        "enum": [
          "passed",
          "rejected",
          "cancelled",
          "unknown"
        ]
      },
      "rationale": {
        "type": "string",
        "minLength": 1
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
