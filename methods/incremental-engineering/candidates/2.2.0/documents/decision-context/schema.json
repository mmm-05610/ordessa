{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordessa:method:incremental-engineering:decision-context:2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "decision-context"
    },
    "schema_version": {
      "const": 2
    },
    "session_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "explicit_decision",
              "explicit_delegation",
              "interpretation",
              "open_question"
            ]
          },
          "validity": {
            "enum": [
              "valid",
              "needs_clarification",
              "superseded"
            ]
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "object_id",
              "revision",
              "digest",
              "locator"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "locator_limitations": {
            "type": "string",
            "minLength": 1
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "object_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "object_id",
                "revision",
                "digest",
                "locator"
              ]
            }
          },
          "unresolved_neighbors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "decision_id",
          "kind",
          "validity",
          "context",
          "statement",
          "scope",
          "source",
          "quote",
          "locator_limitations",
          "supersedes",
          "unresolved_neighbors"
        ]
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "object_id",
          "revision",
          "digest",
          "locator"
        ]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "session_ref",
    "records",
    "source_refs",
    "open_questions"
  ]
}
