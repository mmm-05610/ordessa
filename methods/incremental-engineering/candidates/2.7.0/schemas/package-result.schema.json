{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Candidate external package-result proposal; not an existing persisted domain type.",
  "type": "object", "additionalProperties": false,
  "required": ["method_id", "release_version", "baseline", "candidate", "review", "package_documents"],
  "properties": {
    "method_id": {"type": "string", "const": "ordessa.incremental-engineering"},
    "release_version": {"type": "string", "const": "2.7.0"},
    "baseline": {"$ref": "source-ref.schema.json"},
    "candidate": {"$ref": "source-ref.schema.json"},
    "review": {"$ref": "review-result.schema.json"},
    "package_documents": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["template_resource", "content_digest"], "properties": {
        "template_resource": {"type": "string", "minLength": 1}, "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}
  }
}
