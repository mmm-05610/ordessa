        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "result": {
      "enum": [
        "applied",
        "conflict",
        "unknown",
        "rejected"
      ]
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "proposal_ref",
    "baseline_before",
    "review_refs",
    "notice_ref",
    "acceptance_ref",
    "authorization_ref",
    "exact_patch_ref",
    "result"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "applied"
          }
        }
      },
      "then": {
        "required": [
          "baseline_after",
          "readback_ref"
        ]
      }
    }
  ]
}
