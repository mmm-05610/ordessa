{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordessa:method:incremental-engineering:did-change:2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "did-change"
    },
    "schema_version": {
      "const": 2
    },
    "baseline_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "target_snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "decision_context_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "standard_profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "change_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "add",
              "modify",
              "delete",
              "retain"
            ]
          },
          "target_locator": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "basis_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "object_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "object_id",
                "revision",
                "digest",
                "locator"
              ]
            }
          },
          "semantic_support": {
            "type": "string",
            "minLength": 1
          },
          "authority_kind": {
            "enum": [
              "explicit_decision",
              "explicit_delegation",
              "project_convention",
              "approved_material",
              "observation",
              "reference",
              "hypothesis"
            ]
          },
          "impact": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disposition": {
            "enum": [
              "proposed",
              "authorized_freedom",
              "blocked",
              "retained"
            ]
          }
        },
        "required": [
          "change_id",
          "operation",
          "target_locator",
          "before",
          "after",
          "basis_refs",
          "semantic_support",
          "authority_kind",
          "impact",
          "disposition"
        ]
      }
    },
    "ecp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "affected_owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consumer_and_assembly_impacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_and_migration_impacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "reason",
        "scope",
        "affected_owners",
        "consumer_and_assembly_impacts",
        "data_and_migration_impacts",
        "tradeoffs",
        "risks"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "counter_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kind": {
            "enum": [
              "user_request",
              "observation",
              "inference",
              "design_choice"
            ]
          }
        },
        "required": [
          "claim_id",
          "statement",
          "source_ids",
          "counter_source_ids",
          "kind"
        ]
      }
    },
    "summary_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "baseline_ref",
    "target_snapshot_ref",
    "decision_context_ref",
    "standard_profile_ref",
    "changes",
    "ecp",
    "claims",
    "summary_ref",
    "open_questions"
  ]
}
