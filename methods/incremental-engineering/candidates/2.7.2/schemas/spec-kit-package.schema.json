{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ordessa:method:incremental-engineering:spec-kit-package:2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "spec-kit-package"
    },
    "schema_version": {
      "const": 2
    },
    "baseline_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "target_baseline_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "apply_receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "acceptance_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "source_tree_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "standard_profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "object_id",
        "revision",
        "digest",
        "locator"
      ]
    },
    "status": {
      "enum": [
        "CONVERSION_BLOCKED",
        "PARTIAL_DRAFT",
        "CONVERTED_DRAFT",
        "REVIEWED_FOR_DISPATCH"
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "README.md": {
          "type": "string",
          "minLength": 1
        },
        "baseline.md": {
          "type": "string",
          "minLength": 1
        },
        "change-map.md": {
          "type": "string",
          "minLength": 1
        },
        "spec.md": {
          "type": "string",
          "minLength": 1
        },
        "plan.md": {
          "type": "string",
          "minLength": 1
        },
        "tasks.md": {
          "type": "string",
          "minLength": 1
        },
        "acceptance.md": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "README.md",
        "baseline.md",
        "change-map.md",
        "spec.md",
        "plan.md",
        "tasks.md",
        "acceptance.md"
      ]
    },
    "change_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "change_id": {
            "type": "string",
            "minLength": 1
          },
          "did_locator": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "implement",
              "unaffected_with_evidence",
              "deferred_with_acceptance",
              "blocked"
            ]
          },
          "basis_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "object_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "object_id",
                "revision",
                "digest",
                "locator"
              ]
            }
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "impact_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "change_id",
          "did_locator",
          "disposition",
          "basis_refs",
          "requirement_ids",
          "task_ids",
          "acceptance_ids",
          "impact_evidence"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "source_change_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependency_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "write_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "new_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "retire": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preserve": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authorized_freedom": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stop_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "task_id",
          "source_change_ids",
          "dependency_ids",
          "write_paths",
          "new_paths",
          "inputs",
          "outputs",
          "retire",
          "preserve",
          "authorized_freedom",
          "stop_conditions",
          "acceptance_ids"
        ]
      }
    },
    "blocked_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_state": {
      "const": "planned_not_executed"
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "status",
    "blocked_scopes",
    "questions",
    "verification_state"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PARTIAL_DRAFT",
              "CONVERTED_DRAFT",
              "REVIEWED_FOR_DISPATCH"
            ]
          }
        }
      },
      "then": {
        "required": [
          "baseline_ref",
          "target_baseline_ref",
          "apply_receipt_ref",
          "acceptance_ref",
          "source_tree_ref",
          "standard_profile_ref",
          "files",
          "change_map",
          "tasks"
        ]
      }
    }
  ]
}
