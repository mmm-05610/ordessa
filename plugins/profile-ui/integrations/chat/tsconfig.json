{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@extensions/ordessa.agent-contracts/contract.js": ["../../../agent/contracts/src/contract.ts"],
      "@extensions/ordessa.profile-api/contract.js": ["../../api/src/index.ts"],
      "@extensions/ordessa.contracts/contract.js": ["../../../../packages/frontend/contracts/foundation/src/contract.ts"],
      "@ordessa/ui-components/api": ["../../../../packages/frontend/ui-components/api/ui-components.ts"],
      "@extensions/ordessa.chat-api/contract.js": [
        "../../../chat/api/src/contract.ts"
      ],
      "@ordessa/plugin-profile-api": [
        "../api/src/index.ts"
      ],
      "@ordessa/extension-api": [
        "../../../packages/frontend/extension-api/src/index.ts"
      ],
      "@ordessa/ui": [
        "../../../packages/frontend/ui/src/index.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
