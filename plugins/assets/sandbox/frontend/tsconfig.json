{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@ordessa/extension-api": [
        "../../../packages/frontend/extension-api/src/index.ts"
      ],
      "@extensions/ordessa.contracts/contract.js": [
        "../../../packages/frontend/contracts/foundation/src/contract.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
