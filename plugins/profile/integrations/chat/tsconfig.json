{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@extensions/ordessa.chat-api/contract.js": [
        "../../../chat/api/src/contract.ts"
      ],
      "@ordessa/plugin-profile-api": [
        "../api/src/index.ts"
      ],
      "@ordessa/extension-api": [
        "../../../packages/desktop-platform/extension-api/src/index.ts"
      ],
      "@ordessa/ui": [
        "../../../packages/desktop-platform/ui/src/index.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
