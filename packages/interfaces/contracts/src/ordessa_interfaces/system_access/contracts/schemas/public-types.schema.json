{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordessa.invalid/interfaces/v1/public-types.schema.json",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "Scope": {
      "type": "object",
      "properties": {
        "realm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "realm_id",
        "project_id"
      ],
      "additionalProperties": false
    },
    "Digest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ],
      "additionalProperties": false
    },
    "VersionPrecondition": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "resource",
        "expected_version"
      ],
      "additionalProperties": false
    },
    "CommandName": {
      "enum": [
        "engineering.artifacts.create",
        "engineering.artifacts.append_revision",
        "engineering.proposals.create",
        "engineering.changes.apply",
        "engineering.reviews.request",
        "engineering.reviews.record",
        "engineering.reviews.replace",
        "engineering.reviews.void",
        "engineering.approvals.prepare_intent",
        "engineering.approvals.request",
        "engineering.approvals.revoke",
        "engineering.packages.derive",
        "engineering.proposals.withdraw",
        "engineering.proposals.supersede",
        "engineering.executions.dispatch",
        "engineering.executions.cancel",
        "engineering.submissions.record",
        "engineering.acceptance.request",
        "engineering.acceptance.adopt",
        "execution.agents.units.submit",
        "execution.agents.units.manage",
        "execution.agents.units.cancel"
      ]
    },
    "Origin": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_seq": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "owner",
        "stream_id",
        "source_seq"
      ],
      "additionalProperties": false
    },
    "Causation": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SourceRecordRef": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "schema_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "owner",
        "record_id",
        "schema_id"
      ],
      "additionalProperties": false
    },
    "OperationRef": {
      "type": "object",
      "properties": {
        "authority_id": {
          "$ref": "https://ordessa.invalid/interfaces/v1/public-types.schema.json#/$defs/Id"
        },
        "operation_id": {
          "$ref": "https://ordessa.invalid/interfaces/v1/public-types.schema.json#/$defs/Id"
        }
      },
      "required": [
        "authority_id",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "RequestIdentity": {
      "type": "object",
      "properties": {
        "authority_id": {
          "$ref": "https://ordessa.invalid/interfaces/v1/public-types.schema.json#/$defs/Id"
        },
        "realm_id": {
          "$ref": "https://ordessa.invalid/interfaces/v1/public-types.schema.json#/$defs/Id"
        },
        "principal_id": {
          "$ref": "https://ordessa.invalid/interfaces/v1/public-types.schema.json#/$defs/Id"
        },
        "request_id": {
          "$ref": "https://ordessa.invalid/interfaces/v1/public-types.schema.json#/$defs/Id"
        }
      },
      "required": [
        "authority_id",
        "realm_id",
        "principal_id",
        "request_id"
      ],
      "additionalProperties": false
    }
  }
}
