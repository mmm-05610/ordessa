{
  "schema": {
    "contractVersion": "agent-assembly/1",
    "transport": "wire/1",
    "requestKeyScope": [
      "environmentNamespace",
      "principalScope",
      "requestId"
    ],
    "profileRef": {
      "required": [
        "environmentNamespace",
        "profileId",
        "manifestRevision",
        "contentDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "environmentNamespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "profileId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "manifestRevision": {
          "type": "integer",
          "minimum": 1
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "results": {
      "catalogEntry": {
        "required": [
          "profileId",
          "catalogRevision",
          "displayName",
          "archivedAt",
          "currentManifestRef"
        ]
      },
      "manifest": {
        "required": [
          "ref",
          "content"
        ]
      },
      "list": {
        "required": [
          "entries"
        ]
      },
      "preview": {
        "required": [
          "profileRef",
          "status",
          "referenceCoverage",
          "ready",
          "error"
        ]
      }
    },
    "methods": {
