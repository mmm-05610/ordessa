        ],
        "optional": [],
        "effectful": false
      },
      "agents.profiles.create": {
        "action": "create",
        "required": [
          "profileId",
          "displayName",
          "manifest",
          "requestId"
        ],
        "optional": [],
        "effectful": true
      },
      "agents.profiles.edit": {
        "action": "edit",
        "required": [
          "profileId",
          "manifest",
