{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordessa.invalid/interfaces/v1/request-context.schema.json",
  "type": "object",
  "properties": {
    "realm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authorization_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "owner_activation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "operation_name": {
      "$ref": "https://ordessa.invalid/interfaces/v1/public-types.schema.json#/$defs/CommandName"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authority_id": {
      "$ref": "https://ordessa.invalid/interfaces/v1/public-types.schema.json#/$defs/Id"
    }
  },
  "required": [
    "authority_id",
    "realm_id",
    "principal_id",
    "authorization_generation",
    "owner_activation",
    "request_id",
    "operation_name",
    "project_id",
    "correlation_id"
  ],
  "additionalProperties": false,
  "description": "服务端认证与scope解析后构造的公共port类型；不得接受客户端自报此对象作为授权。"
}
