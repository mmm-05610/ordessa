{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DecisionResult",
  "$defs": {
    "DecisionResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "task_revision": {
          "type": "string"
        },
        "flow_ref": {
          "$ref": "#/$defs/FlowRef"
        },
        "run_manifest_digest": {
          "type": "string"
        },
        "effective_policy_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PolicyRef"
          }
        },
        "status": {
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/BusinessOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "call_evidence": {
          "type": "string"
        },
        "exhausted_dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "consumed": {
          "type": "object"
        },
        "evidence_summary_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "request_id",
        "task_revision",
        "flow_ref",
        "run_manifest_digest",
        "effective_policy_refs",
        "status"
      ]
    },
    "FlowRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flow_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "content_digest": {
          "type": "string"
        }
      },
      "required": [
        "flow_id",
        "version",
        "content_digest"
      ]
    },
    "PolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "content_digest": {
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "content_digest"
      ]
    },
    "BusinessOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "type": "string"
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProposalDraft"
          }
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationReceipt"
          }
        },
        "issues": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "disposition"
      ]
    },
    "ProposalDraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "type": "string"
        },
        "proposal_kind": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "basis_observation_ids": {
          "type": "array",
          "items": {}
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Precondition"
          }
        },
        "rationale_codes": {
          "type": "array",
          "items": {}
        },
        "required_validation_obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationObligation"
          }
        }
      },
      "required": [
        "proposal_id",
        "proposal_kind",
        "payload"
      ]
    },
    "Precondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "subject_ref": {
          "$ref": "#/$defs/ExternalRef"
        },
        "expected_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirement": {
          "type": "string"
        },
        "checker_id": {
          "type": "string"
        },
        "checker_version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "condition_id",
        "kind",
        "subject_ref",
        "expected_version",
        "expected_digest",
        "requirement",
        "checker_id",
        "checker_version"
      ]
    },
    "ExternalRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_namespace": {
          "type": "string"
        },
        "identity": {
          "type": "object"
        }
      },
      "required": [
        "source_namespace",
        "identity"
      ]
    },
    "ValidationObligation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "obligation_id": {
          "type": "string"
        },
        "subject_ref": {
          "$ref": "#/$defs/ExternalRef"
        },
        "requirement": {
          "type": "string"
        },
        "validator_kind": {
          "type": "string"
        },
        "version_constraint": {
          "type": "string"
        }
      },
      "required": [
        "obligation_id",
        "subject_ref",
        "requirement",
        "validator_kind",
        "version_constraint"
      ]
    },
    "ValidationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validator_id": {
          "type": "string"
        },
        "validator_version": {
          "type": "string"
        },
        "proposal_digest": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "obligation_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObligationResult"
          }
        },
        "checked_at": {
          "type": "string"
        },
        "validation_scope": {
          "type": "string"
        },
        "validated_observation_versions": {
          "type": "object"
        },
        "issues": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "validator_id",
        "validator_version",
        "proposal_digest",
        "status",
        "obligation_results",
        "checked_at",
        "validation_scope"
      ]
    },
    "ObligationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "obligation_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "checker_id": {
          "type": "string"
        },
        "checker_version": {
          "type": "string"
        },
        "source_versions": {
          "type": "object"
        },
        "evidence_refs": {
          "type": "array",
          "items": {}
        },
        "exemption_policy_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "obligation_id",
        "status",
        "checker_id",
        "checker_version"
      ]
    }
  }
}
