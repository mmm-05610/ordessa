{
  "name": "ordessa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "plugins/**",
    "!plugins/harness/**",
    "plugins/workbench/chat/api",
    "plugins/workbench/chat/frontend",
    "plugins/agents/profiles/ui/api",
    "plugins/agents/profiles/ui/frontend",
    "plugins/agents/resources/model-provider/desktop",
    "packages/interfaces/channels/workbench/extension-api/contracts/harness",
    "apps/desktop/packaging/product",
    "packages/interfaces/channels/workbench/extension-api",
    "packages/interfaces/channels/workbench/extension-api/connections",
    "packages/interfaces/channels/workbench/extension-api/contracts/foundation",
    "packages/interfaces/channels/workbench/extension-runtime/loader",
    "packages/interfaces/channels/workbench/extension-runtime/runtime",
    "packages/interfaces/channels/workbench/extension-runtime/host",
    "packages/interfaces/channels/workbench/shell/workbench",
    "packages/interfaces/channels/workbench/shell/workbench/interactions",
    "packages/interfaces/channels/workbench/extension-runtime/ui-components",
    "packages/interfaces/channels/workbench/ui",
    "apps/desktop/electron/server-bridge",
    "apps/desktop/electron/native-bridge",
    "packages/interfaces/channels/workbench/status-board",
    "packages/interfaces/transport/client/typescript",
    "packages/interfaces/contracts/typescript"
  ],
  "scripts": {
    "test:agent-ui": "node apps/desktop/tests/smoke/test-agent-ui.mjs",
    "test:ui-preview": "node apps/desktop/tests/smoke/test-ui-preview.mjs",
    "test:agent-shell": "node apps/desktop/tests/smoke/test-agent-shell.mjs",
    "build:foundations": "node tooling/workspace/build-all.mjs",
    "dev": "npm run --workspace apps/desktop dev",
    "build": "npm run --workspace apps/desktop build",
    "build:deb": "node apps/desktop/packaging/build-deb.mjs",
    "package:keygen": "node apps/desktop/packaging/update/keygen.mjs apps/desktop/packaging/.keys",
    "package:publish-update": "node apps/desktop/packaging/update/publish.mjs",
    "test:packaging": "node --test \"tests/integration/packaging/**/*.test.mjs\"",
    "test:harness-packaging": "mkdir -p .nightly-cache/harness-test-tmp && TMPDIR=\"${TMPDIR:-$PWD/.nightly-cache/harness-test-tmp}\" node --test --test-concurrency=1 \"plugins/harness/*/tests/packaging/**/*.test.mjs\"",
    "typecheck": "npm run --workspace apps/desktop typecheck",
    "test": "node tooling/checks/test-all.mjs",
    "test:electron": "npm run --workspace apps/desktop test:electron",
    "build:examples": "node tooling/workspace/build-examples.mjs",
    "test:extensions": "node apps/desktop/tests/smoke/test-extensions.mjs",
    "test:ui-service": "node apps/desktop/tests/smoke/test-ui-service.mjs",
    "test:ui-foundations": "node apps/desktop/tests/smoke/test-ui-foundations.mjs",
    "start": "npm run --workspace apps/desktop start",
    "test:packaging:clean": "bash tooling/release/clean-machine-accept.sh apps/desktop/packaging/.out/ordessa_0.1.0_amd64.deb",
    "dev:status-board": "npm run --workspace apps/status-board dev",
    "start:status-board": "npm run --workspace apps/status-board start:electron"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "saxes": "6.0.0"
  }
}
